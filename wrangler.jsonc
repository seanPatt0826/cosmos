// Cloudflare deploy settings. Deploy with tools/deploy.sh, which fills dist/
// from the last commit rather than from whatever is in the folder.
{
  "name": "cosmos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Shuttle Docking rooms: one Durable Object per room code. SQLite-backed,
  // the kind the free plan allows, though the rooms store nothing.
  "durable_objects": {
    "bindings": [{ "name": "DOCK", "class_name": "DockRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DockRoom"] }],
  // The site's own address. Both are attached as Custom Domains, so
  // Cloudflare keeps their DNS records and HTTPS certificates itself.
  "routes": [
    { "pattern": "cosmosroulette.com", "custom_domain": true },
    { "pattern": "www.cosmosroulette.com", "custom_domain": true }
  ]
}
