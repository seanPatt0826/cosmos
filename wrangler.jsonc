// Cloudflare deploy settings. Deploy with tools/deploy.sh, which fills dist/
// from the last commit rather than from whatever is in the folder.
{
  "name": "cosmos",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // The online Shuttle Docking rooms (a Durable Object) were added in v1 and
  // retired in v2; docking is now a universe on the main page. Cloudflare
  // needs both entries kept, in order, to know the class is gone.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DockRoom"] },
    { "tag": "v2", "deleted_classes": ["DockRoom"] }
  ],
  // The site's own address. Both are attached as Custom Domains, so
  // Cloudflare keeps their DNS records and HTTPS certificates itself.
  "routes": [
    { "pattern": "cosmosroulette.com", "custom_domain": true },
    { "pattern": "www.cosmosroulette.com", "custom_domain": true }
  ]
}
